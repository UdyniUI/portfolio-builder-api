# Database Configuration
DB_USER=portfoliosos
DB_PASSWORD=dev_password_123
DB_NAME=portfoliosos_dev
DATABASE_URL=postgresql://portfoliosos:dev_password_123@localhost:5432/portfoliosos_dev

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development

# Auth0 Configuration
AUTH0_DOMAIN=your-auth0-domain.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# Claude API (for résumé extraction)
CLAUDE_API_KEY=sk-ant-xxx-your-key-here

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Security
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging
LOG_LEVEL=INFO
